<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_bizfinder_search_form" model="ir.ui.view">
    <field name="name">bizfinder.search.form</field>
    <field name="model">bizfinder.search</field>
    <field name="arch" type="xml">
      <form string="Prospect Search" class="o_bizfinder_search_form"
            js_class="bizfinder_search_form"
            create="false" edit="true" delete="false" duplicate="false">
        <header>
          <button name="action_search" string="Search" type="object" class="btn-primary"/>
        </header>
        <sheet>
          <!-- Preset segment (left) + regions filter (right) on one row.
               Each block stacks label-on-top, field-below. The description
               sits in a fixed-height muted region so the layout doesn't
               reflow as the user cycles through presets.
               force_save="1" on preset_description: the value is set by
               the preset_key onchange but the field is view-readonly, so
               without it the JS form would drop the change before save. -->
          <div class="row align-items-start mb-3">
            <div class="col-12 col-lg-6">
              <label for="preset_key" string="Preset segment" class="o_form_label fw-bold d-block mb-1"/>
              <field name="preset_key" nolabel="1" class="d-block mb-2"/>
              <div class="text-muted small"
                   style="min-height: 4.5em; line-height: 1.4;">
                <field name="preset_description" nolabel="1" readonly="1" force_save="1"
                       placeholder="Pick a preset to auto-fill filters, or open Advanced for manual setup."/>
              </div>
            </div>
            <div class="col-12 col-lg-6">
              <label for="region_ids" string="Regions" class="o_form_label fw-bold d-block mb-1"/>
              <field name="region_ids" widget="many2many_tags" nolabel="1" class="d-block"
                     placeholder="Pick one or more counties..."/>
            </div>
          </div>

          <group string="Find companies" name="quick_search">
            <group>
              <field name="industry_preset"/>
              <field name="post_community_names"
                     placeholder="Linköping, Norrköping..."/>
            </group>
            <group>
              <label for="net_sales_min" string="Net sales (tkr)"/>
              <div class="o_row">
                <field name="net_sales_min" placeholder="Min"/>
                <span> – </span>
                <field name="net_sales_max" placeholder="Max"/>
              </div>
              <label for="employees_min" string="Employees"/>
              <div class="o_row">
                <field name="employees_min" placeholder="Min"/>
                <span> – </span>
                <field name="employees_max" placeholder="Max"/>
              </div>
            </group>
          </group>

          <div class="o_bizfinder_search_counts d-flex gap-3 mb-2"
               invisible="not hit_count and not returned_count">
            <span class="text-muted small">Matches:
              <field name="hit_count" readonly="1" class="d-inline-block oe_inline"/>
            </span>
            <span class="text-muted small">Shown:
              <field name="returned_count" readonly="1" class="d-inline-block oe_inline"/>
            </span>
          </div>

          <div class="mb-2" invisible="duplicate_count == 0">
            <span class="text-muted small me-1">Already in CRM:</span>
            <field name="duplicate_count" readonly="1" class="d-inline-block oe_inline"/>
          </div>

          <details class="mt-3">
            <summary class="btn btn-link p-0" style="cursor: pointer;">Advanced filters</summary>
            <div class="row mt-2">
            <div class="col-12 col-xl-4">
              <group string="Company" name="filter_company">
                <field name="sni_prefixes"/>
                <field name="legal_forms"/>
                <field name="turnover_buckets"/>
                <field name="employee_buckets"/>
                <field name="units_min"/>
                <field name="units_max"/>
              </group>
            </div>
            <div class="col-12 col-xl-4">
              <group string="Location" name="filter_location">
                <field name="post_community_codes"/>
                <field name="registered_community_codes"/>
                <field name="visiting_region_ids" widget="many2many_tags"/>
                <field name="visiting_community_codes"/>
                <field name="post_zip_prefixes"/>
                <field name="registered_zip_prefixes"/>
                <field name="visiting_zip_prefixes"/>
              </group>
            </div>
            <div class="col-12 col-xl-4">
              <group string="Status and recency" name="filter_status">
                <field name="f_tax"/>
                <field name="moms"/>
                <field name="accountant_reservation"/>
                <field name="accountant_obligation"/>
                <field name="registered_max_months" string="Max age (mo)"/>
                <field name="registered_min_months" string="Min age (mo)"/>
                <field name="formed_max_months"/>
                <field name="formed_min_months"/>
                <field name="status_changed_max_months"/>
                <field name="status_changed_min_months"/>
                <field name="reservation_max_months"/>
                <field name="reservation_min_months"/>
              </group>
            </div>
            <div class="col-12 col-xl-6">
              <group string="Financials (latest year)" name="filter_financials">
                <label for="net_operating_income_min" string="Operating income (tkr)"/>
                <div class="o_row">
                  <field name="net_operating_income_min"/>
                  <span> – </span>
                  <field name="net_operating_income_max"/>
                </div>
                <label for="operating_result_min" string="Operating result (tkr)"/>
                <div class="o_row">
                  <field name="operating_result_min"/>
                  <span> – </span>
                  <field name="operating_result_max"/>
                </div>
                <label for="profit_after_fin_min" string="Profit after financials (tkr)"/>
                <div class="o_row">
                  <field name="profit_after_fin_min"/>
                  <span> – </span>
                  <field name="profit_after_fin_max"/>
                </div>
                <label for="net_profit_loss_min" string="Net profit/loss (tkr)"/>
                <div class="o_row">
                  <field name="net_profit_loss_min"/>
                  <span> – </span>
                  <field name="net_profit_loss_max"/>
                </div>
                <label for="growth_pct_min" string="Growth %"/>
                <div class="o_row">
                  <field name="growth_pct_min"/>
                  <span> – </span>
                  <field name="growth_pct_max"/>
                </div>
                <label for="headcount_change_min" string="Headcount growth %"/>
                <div class="o_row">
                  <field name="headcount_change_min"/>
                  <span> – </span>
                  <field name="headcount_change_max"/>
                </div>
                <label for="solidity_pct_min" string="Solidity %"/>
                <div class="o_row">
                  <field name="solidity_pct_min"/>
                  <span> – </span>
                  <field name="solidity_pct_max"/>
                </div>
                <label for="operating_margin_min" string="Operating margin %"/>
                <div class="o_row">
                  <field name="operating_margin_min"/>
                  <span> – </span>
                  <field name="operating_margin_max"/>
                </div>
                <label for="profit_margin_min" string="Profit margin %"/>
                <div class="o_row">
                  <field name="profit_margin_min"/>
                  <span> – </span>
                  <field name="profit_margin_max"/>
                </div>
                <label for="quick_ratio_min" string="Quick ratio %"/>
                <div class="o_row">
                  <field name="quick_ratio_min"/>
                  <span> – </span>
                  <field name="quick_ratio_max"/>
                </div>
              </group>
            </div>
            <div class="col-12 col-xl-6">
              <group string="Financial scale" name="filter_financial_scale">
                <label for="cash_min" string="Cash and bank (tkr)"/>
                <div class="o_row">
                  <field name="cash_min"/>
                  <span> – </span>
                  <field name="cash_max"/>
                </div>
                <label for="turnover_per_employee_min" string="Turnover/employee (tkr)"/>
                <div class="o_row">
                  <field name="turnover_per_employee_min"/>
                  <span> – </span>
                  <field name="turnover_per_employee_max"/>
                </div>
                <label for="assets_min" string="Assets (tkr)"/>
                <div class="o_row">
                  <field name="assets_min"/>
                  <span> – </span>
                  <field name="assets_max"/>
                </div>
                <label for="equity_min" string="Equity (tkr)"/>
                <div class="o_row">
                  <field name="equity_min"/>
                  <span> – </span>
                  <field name="equity_max"/>
                </div>
                <label for="current_liabilities_min" string="Current liabilities (tkr)"/>
                <div class="o_row">
                  <field name="current_liabilities_min"/>
                  <span> – </span>
                  <field name="current_liabilities_max"/>
                </div>
                <label for="long_term_debts_min" string="Long-term debts (tkr)"/>
                <div class="o_row">
                  <field name="long_term_debts_min"/>
                  <span> – </span>
                  <field name="long_term_debts_max"/>
                </div>
                <label for="account_months_min" string="Account months"/>
                <div class="o_row">
                  <field name="account_months_min"/>
                  <span> – </span>
                  <field name="account_months_max"/>
                </div>
                <label for="dividend_min" string="Dividend (tkr)"/>
                <div class="o_row">
                  <field name="dividend_min"/>
                  <span> – </span>
                  <field name="dividend_max"/>
                </div>
              </group>
            </div>
          </div>
          </details>

          <notebook>
            <page string="Results" name="results">
              <!-- Action row above the list. The CSS hooks under
                   .o_bizfinder_results_actions visually align this with
                   the list's pager row (rendered top-right of the list
                   widget) so they read as a single toolbar. -->
              <div class="o_bizfinder_results_actions d-flex align-items-center mt-2"
                   invisible="not result_line_ids">
                <button name="action_create_leads"
                        string="Create lead"
                        type="object" class="btn-primary"/>
                <span class="text-muted small ms-3">
                  Selected reveals:
                  <field name="selected_reveal_count" readonly="1" class="d-inline-block oe_inline"/>
                </span>
                <span class="text-muted small ms-3">
                  Estimate:
                  <field name="estimated_reveal_total" readonly="1" class="d-inline-block oe_inline"/>
                  <field name="billing_currency" readonly="1" class="d-inline-block oe_inline"/>
                </span>
                <span class="text-muted small ms-3">
                  Price/reveal:
                  <field name="price_per_reveal" readonly="1" class="d-inline-block oe_inline"/>
                </span>
              </div>
              <field name="result_line_ids" nolabel="1">
                <list editable="top" create="false" delete="false">
                  <field name="selected" width="40px"/>
                  <field name="name"/>
                  <field name="organisation_number" string="Org no."/>
                  <field name="city"/>
                  <field name="post_community" optional="show"/>
                  <field name="post_code" string="Zip" optional="hide"/>
                  <field name="description" string="SNI"/>
                  <field name="turn_over" string="Turnover" optional="show"/>
                  <field name="net_sales" optional="show"/>
                  <field name="director_name" optional="show"/>
                  <field name="director_role" optional="hide"/>
                  <field name="operating_result" optional="show"/>
                  <field name="net_profit_loss" optional="hide"/>
                  <field name="employees" optional="show"/>
                  <field name="growth_pct" string="Growth %"/>
                  <field name="headcount_change_pct" optional="hide"/>
                  <field name="solidity_pct" string="Solidity %"/>
                  <field name="operating_margin_pct" optional="hide"/>
                  <field name="profit_margin_pct" optional="hide"/>
                  <field name="quick_ratio_pct" optional="hide"/>
                  <field name="cash_at_bank" optional="hide"/>
                  <field name="total_assets" optional="hide"/>
                  <field name="total_equity" optional="hide"/>
                  <field name="account_date_to" optional="show"/>
                  <field name="account_months" optional="hide"/>
                  <field name="number_of_units" optional="hide"/>
                  <field name="registration_date" string="Reg." optional="hide"/>
                  <field name="company_formed_date" optional="hide"/>
                  <field name="status_date" optional="hide"/>
                  <field name="legal_entity" string="Form" optional="hide"/>
                  <field name="vat_number" optional="hide"/>
                </list>
              </field>
              <p class="text-muted small mt-2 mb-0">
                Phone, director, address and other contact details are
                redacted in the preview and revealed only when you create
                leads (one billable reveal per selected company).
              </p>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_bizfinder_search_open" model="ir.actions.server">
    <field name="name">Prospect</field>
    <field name="path">prospect</field>
    <field name="model_id" ref="model_bizfinder_search"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_search()</field>
  </record>
</odoo>
