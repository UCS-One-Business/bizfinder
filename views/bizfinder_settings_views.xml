<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="res_config_settings_view_form_bizfinder" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.bizfinder</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app data-string="Bizfinder" string="Bizfinder" name="bizfinder" groups="sales_team.group_sale_manager">
          <block title="Bizfinder API" name="bizfinder_api">
            <setting id="bizfinder_api_url_setting" string="API URL">
              <field name="bizfinder_api_url"/>
            </setting>
            <setting id="bizfinder_access_token_setting" string="Access Token">
              <field name="bizfinder_access_token" password="True"/>
            </setting>
            <setting id="bizfinder_test_connection_setting" string="Connection">
              <button name="action_bizfinder_test_connection"
                      string="Test connection" type="object" class="btn-secondary"/>
            </setting>
            <setting id="bizfinder_sync_setting" string="Catalogues"
                     help="Refresh kommun, SNI, bucket and legal-form lookup tables from the API.">
              <button name="action_bizfinder_sync_catalogues"
                      string="Refresh catalogues" type="object" class="btn-primary"/>
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
