<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Saved presets: a plain list/form so users can rename, edit the
       description and delete. The stored filter payload is read-only (it is
       written by the wizard's "Save as preset" action). -->
  <record id="view_bizfinder_preset_list" model="ir.ui.view">
    <field name="name">bizfinder.preset.list</field>
    <field name="model">bizfinder.preset</field>
    <field name="arch" type="xml">
      <list string="Saved presets" editable="bottom">
        <field name="name"/>
        <field name="description"/>
        <field name="user_id" optional="show"/>
        <field name="company_id" groups="base.group_multi_company" optional="show"/>
      </list>
    </field>
  </record>

  <record id="view_bizfinder_preset_form" model="ir.ui.view">
    <field name="name">bizfinder.preset.form</field>
    <field name="model">bizfinder.preset</field>
    <field name="arch" type="xml">
      <form string="Saved preset">
        <sheet>
          <group>
            <field name="name"/>
            <field name="description"/>
            <field name="user_id"/>
            <field name="company_id" groups="base.group_multi_company"/>
          </group>
          <group string="Stored filters (read-only)">
            <field name="filters_json" nolabel="1" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_bizfinder_preset" model="ir.actions.act_window">
    <field name="name">Bizfinder Saved Presets</field>
    <field name="res_model">bizfinder.preset</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Save-current dialog opened from the wizard header cogwheel. -->
  <record id="view_bizfinder_preset_save_form" model="ir.ui.view">
    <field name="name">bizfinder.preset.save.form</field>
    <field name="model">bizfinder.preset.save</field>
    <field name="arch" type="xml">
      <form string="Save filters as preset">
        <sheet>
          <field name="wizard_id" invisible="1"/>
          <field name="preset_id" invisible="1"/>
          <group>
            <field name="name" placeholder="e.g. Growing IT consultancies in Skåne"/>
            <field name="description" placeholder="Optional note shown when this preset is picked"/>
          </group>
          <div class="text-muted small" invisible="not preset_id">
            This will overwrite the selected saved preset with the current filters.
          </div>
        </sheet>
        <footer>
          <button name="action_save" string="Save" type="object" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
