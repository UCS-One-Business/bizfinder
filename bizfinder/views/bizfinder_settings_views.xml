<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="res_config_settings_view_form_bizfinder" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.bizfinder</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//app[@name='crm']" position="inside">
        <block title="Bizfinder" name="bizfinder_api"
               help="Creditsafe-backed lead generation. The service URL is built in; only the access token issued to your company is needed.">
          <!-- The service URL is built in (DEFAULT_BIZFINDER_API_URL);
               customers only paste their access token. Dev/test may
               override the URL via the BIZFINDER_API_URL env var. -->
          <setting id="bizfinder_access_token_setting" string="Access Token">
            <field name="bizfinder_access_token" password="True"/>
          </setting>
          <setting id="bizfinder_test_connection_setting" string="Connection">
            <button name="action_bizfinder_test_connection"
                    string="Test connection" type="object" class="btn-secondary"/>
          </setting>
          <setting id="bizfinder_monitoring_setting"
                   help="Experimental, off by default. Daily registry sync of monitored companies: status, financial health badge and change events (F-tax, VAT, status) on company contacts.">
            <field name="group_bizfinder_monitoring"/>
          </setting>
        </block>
      </xpath>
    </field>
  </record>
</odoo>
