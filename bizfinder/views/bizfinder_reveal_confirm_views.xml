<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_bizfinder_reveal_confirm_form" model="ir.ui.view">
    <field name="name">bizfinder.reveal.confirm.form</field>
    <field name="model">bizfinder.reveal.confirm</field>
    <field name="arch" type="xml">
      <form string="Confirm Billable Reveals" create="false" edit="false" delete="false">
        <sheet>
          <group>
            <field name="reveal_count" string="Selected leads"/>
            <field name="estimated_total_display" string="Total price"/>
          </group>
        </sheet>
        <footer>
          <button name="action_confirm" string="Confirm and create leads" type="object" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
