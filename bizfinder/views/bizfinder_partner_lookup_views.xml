<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Lookup wizard: search + pick. Lookup rows are redacted tier - the API
       returns no street/phone here; the follow-up sync fills status and
       financials instead. -->
  <record id="view_bizfinder_partner_lookup_form" model="ir.ui.view">
    <field name="name">bizfinder.partner.lookup.form</field>
    <field name="model">bizfinder.partner.lookup</field>
    <field name="arch" type="xml">
      <form string="Fetch from Bizfinder">
        <group>
          <field name="partner_id" invisible="1"/>
          <field name="query" placeholder="e.g. Nordfält Bygg or 556677"/>
        </group>
        <div class="text-muted mb-2">
          Search by company name or organisation number, then pick a result.
          The pick links the company (organisation number) and syncs status
          and financials from Bizfinder. Lookup results carry no street or
          phone - existing contact details are never overwritten.
        </div>
        <field name="line_ids">
          <list create="false" delete="false" editable="bottom">
            <field name="name"/>
            <field name="organisation_number"/>
            <field name="city"/>
            <field name="legal_entity_text"/>
            <field name="sni_text" optional="show"/>
            <field name="employees" optional="show"/>
            <button name="action_pick" type="object" string="Pick" icon="fa-check"/>
          </list>
        </field>
        <footer>
          <button name="action_search" type="object" string="Search" class="btn-primary"/>
          <button string="Close" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_bizfinder_partner_lookup" model="ir.actions.act_window">
    <field name="name">Fetch from Bizfinder</field>
    <field name="res_model">bizfinder.partner.lookup</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="binding_model_id" ref="base.model_res_partner"/>
    <field name="binding_view_types">list</field>
    <field name="group_ids" eval="[(4, ref('bizfinder.group_bizfinder_monitoring'))]"/>
  </record>
</odoo>
