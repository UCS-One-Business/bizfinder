<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- CRM > Bizfinder section. Keeps its historical XML id (it used to be a
       leaf pointing straight at the search wizard); it now fans out to the
       search and the monitoring event log. -->
  <menuitem id="menu_bizfinder_search"
            name="Bizfinder"
            parent="crm.crm_menu_root"
            sequence="50"
            groups="sales_team.group_sale_salesman"/>
  <menuitem id="menu_bizfinder_search_wizard"
            name="Search"
            parent="menu_bizfinder_search"
            action="action_bizfinder_search"
            sequence="10"
            groups="sales_team.group_sale_salesman"/>
  <!-- Gated on the monitoring feature toggle: the group is only implied
       (to salesmen) while Settings > Company Monitoring is checked. -->
  <menuitem id="menu_bizfinder_company_events"
            name="Company Events"
            parent="menu_bizfinder_search"
            action="action_bizfinder_company_event"
            sequence="20"
            groups="bizfinder.group_bizfinder_monitoring"/>
  <!-- Billing usage is no longer a top-level menu: managers reach it from the
       "This month … Details" link in the search results toolbar
       (bizfinder.search.action_open_month_usage). The act_window server action
       below still backs the /odoo/bizfinder-usage URL. -->
</odoo>
