<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_bizfinder_search_form" model="ir.ui.view">
    <field name="name">bizfinder.search.form</field>
    <field name="model">bizfinder.search</field>
    <field name="arch" type="xml">
      <form string="Bizfinder Search" class="o_bizfinder_search_form"
            js_class="bizfinder_search_form"
            create="false" edit="true" delete="false" duplicate="false">
        <header>
          <button name="action_search" string="Search" type="object" class="btn-primary"/>
          <!-- Preset management (save / update / clear / manage) lives in this
               native Dropdown cog widget; the controller reparents the whole
               statusbar next to the "Bizfinder" breadcrumb title. -->
          <widget name="bizfinder_preset_cog"/>
        </header>
        <sheet>
          <!-- One preset picker across the top; the description below has a
               fixed-height muted region so the layout doesn't reflow as the
               user cycles through presets. -->
          <div class="mb-3">
            <label for="preset_id" string="Preset" class="o_form_label fw-bold d-block mb-1"/>
            <div class="mb-2">
              <field name="preset_id" nolabel="1" class="d-block"
                     options="{'no_create_edit': True, 'no_quick_create': True}"
                     placeholder="Pick a preset to auto-fill filters…"/>
            </div>
            <div class="text-muted small"
                 style="min-height: 3em; line-height: 1.4;"
                 invisible="not preset_id">
              <field name="preset_description" nolabel="1" readonly="1"/>
            </div>
          </div>

          <group name="quick_search">
            <group>
              <field name="region_ids" widget="many2many_tags"
                     placeholder="Pick one or more counties..."/>
              <field name="industry_ids" widget="many2many_tags"
                     options="{'no_create': True, 'no_quick_create': True}"
                     placeholder="Pick one or more industries..."/>
            </group>
            <group>
              <field name="net_sales_magnitude_ids" widget="many2many_tags"
                     options="{'no_create': True, 'no_quick_create': True}"
                     placeholder="Pick turnover bands..."/>
              <field name="employee_magnitude_ids" widget="many2many_tags"
                     options="{'no_create': True, 'no_quick_create': True}"
                     placeholder="Pick employee bands..."/>
            </group>
          </group>

          <details class="mt-3">
            <summary class="btn btn-link p-0" style="cursor: pointer;">Advanced filters</summary>
            <!-- Each <group string="..."> below contains two inner <group>s
                 so Odoo renders the fields in two side-by-side columns
                 instead of stacking everything on the left. -->
            <!-- Company: tag pickers + the YES/NO compliance toggles
                 collapsed into one section since they all describe
                 "what kind of company is this". -->
            <group string="Company" name="filter_company">
              <group>
                <field name="legal_form_ids" widget="many2many_tags"
                       options="{'no_create': True, 'no_quick_create': True}"
                       placeholder="AB, EF..."/>
              </group>
              <group>
                <field name="f_tax"/>
                <field name="moms"/>
                <field name="accountant_reservation"/>
                <field name="accountant_obligation"/>
              </group>
            </group>

            <group string="Location" name="filter_location">
              <group>
                <field name="alt_community_ids" widget="many2many_tags"
                       options="{'no_create': True, 'no_quick_create': True}"
                       placeholder="Registered or visiting kommun..."/>
              </group>
              <group>
                <field name="zip_prefixes" placeholder="58, 591, 60..."
                       help="Matches if any of postal / registered / visiting ZIP starts with one of these prefixes."/>
              </group>
            </group>

            <!-- Date ranges: each filter is a label + two Date inputs
                 in an o_row so they sit horizontally and use the lang's
                 full date format (no "smart" current-year truncation
                 like the daterange widget does). -->
            <group string="Dates" name="filter_dates">
              <group>
                <label for="registration_date_from" string="Registered"/>
                <div class="o_row">
                  <field name="registration_date_from" nolabel="1"/>
                  <span> – </span>
                  <field name="registration_date_to" nolabel="1"/>
                </div>
                <label for="status_date_from" string="Status changed"/>
                <div class="o_row">
                  <field name="status_date_from" nolabel="1"/>
                  <span> – </span>
                  <field name="status_date_to" nolabel="1"/>
                </div>
              </group>
              <group>
                <label for="reservation_date_from" string="Auditor reservation"/>
                <div class="o_row">
                  <field name="reservation_date_from" nolabel="1"/>
                  <span> – </span>
                  <field name="reservation_date_to" nolabel="1"/>
                </div>
              </group>
            </group>

            <!-- Financials & ratios: trimmed to the handful of ranges sales
                 actually filters on. Turnover / profit / headcount on the
                 left, the two key percentages on the right. -->
            <group string="Financials &amp; ratios" name="filter_financials">
              <group>
                <label for="net_sales_min" string="Turnover (tkr)"/>
                <div class="o_row">
                  <field name="net_sales_min" placeholder="-10 000 000"/>
                  <span> – </span>
                  <field name="net_sales_max" placeholder="100 000 000"/>
                </div>
                <label for="net_profit_loss_min" string="Net profit/loss (tkr)"/>
                <div class="o_row">
                  <field name="net_profit_loss_min" placeholder="-10 000 000"/>
                  <span> – </span>
                  <field name="net_profit_loss_max" placeholder="100 000 000"/>
                </div>
                <label for="employees_min" string="Employees (exact)"/>
                <div class="o_row">
                  <field name="employees_min" placeholder="0"/>
                  <span> – </span>
                  <field name="employees_max" placeholder="100 000"/>
                </div>
              </group>
              <group>
                <label for="growth_pct_min" string="Growth %"/>
                <div class="o_row">
                  <field name="growth_pct_min" placeholder="-100"/>
                  <span> – </span>
                  <field name="growth_pct_max" placeholder="500"/>
                </div>
                <label for="solidity_pct_min" string="Solidity %"/>
                <div class="o_row">
                  <field name="solidity_pct_min" placeholder="-100"/>
                  <span> – </span>
                  <field name="solidity_pct_max" placeholder="100"/>
                </div>
              </group>
            </group>
          </details>

          <notebook>
            <page string="Results" name="results">
              <!-- Action row above the list. The js_class controller relocates
                   the list's pager (.o_cp_pager) into this row - see
                   bizfinder_search_form.js - so the Create-lead button, the
                   billing estimate and the pager read as a single toolbar. -->
              <div class="o_bizfinder_results_actions d-flex align-items-center mt-2"
                   invisible="not result_line_ids">
                <button name="action_create_leads"
                        string="Create lead"
                        type="object" class="btn-primary"/>
                <span class="text-muted small ms-3">
                  Selected reveals:
                  <field name="selected_reveal_count" readonly="1" class="d-inline-block oe_inline"/>
                </span>
                <!-- Estimate / price-per-reveal moved out of the toolbar: they
                     are shown on the reveal-confirmation modal instead. -->
                <field name="month_usage_loaded" invisible="1"/>
                <!-- Flex spacer: the single ms-auto in this row. Pushes the
                     month-to-date stat and the relocated pager to the right
                     edge, regardless of whether the (manager-only) stat is
                     shown. Keeping the auto-margin here rather than on the stat
                     avoids a second auto-margin fighting the pager. -->
                <span class="ms-auto"/>
                <!-- Spend-to-date for this month, managers only. Sits just left
                     of the pager as a separate "billing" cluster from the
                     per-search estimate. Replaces the old top-level menu. -->
                <span class="text-muted small"
                      groups="sales_team.group_sale_manager"
                      invisible="not month_usage_loaded">
                  This month:
                  <field name="month_usage_display" readonly="1"
                         class="d-inline-block oe_inline ms-1"/>
                  <button name="action_open_month_usage" type="object"
                          string="Details"
                          class="btn btn-link btn-sm p-0 ms-2 align-baseline"/>
                </span>
              </div>
              <field name="result_line_ids" nolabel="1">
                <list editable="top" create="false" delete="false">
                  <field name="selected" width="40px"/>
                  <field name="name"/>
                  <field name="organisation_number" string="Org no."/>
                  <field name="city"/>
                  <field name="post_community" optional="hide"/>
                  <field name="post_code" string="Zip" optional="hide"/>
                  <field name="description" string="SNI"/>
                  <field name="turn_over" string="Turnover" optional="show"/>
                  <field name="net_sales" optional="hide"/>
                  <field name="net_profit_loss" optional="show"/>
                  <field name="employees" optional="show"/>
                  <field name="growth_pct" string="Growth %"/>
                  <field name="solidity_pct" string="Solidity %"/>
                  <field name="director_name" optional="hide"/>
                  <field name="director_role" optional="hide"/>
                  <field name="operating_result" optional="hide"/>
                  <field name="headcount_change_pct" optional="hide"/>
                  <field name="operating_margin_pct" optional="hide"/>
                  <field name="profit_margin_pct" optional="hide"/>
                  <field name="quick_ratio_pct" optional="hide"/>
                  <field name="cash_at_bank" optional="hide"/>
                  <field name="total_assets" optional="hide"/>
                  <field name="total_equity" optional="hide"/>
                  <field name="account_date_to" optional="hide"/>
                  <field name="registration_date" string="Reg." optional="hide"/>
                  <field name="company_formed_date" optional="hide"/>
                  <field name="status_date" optional="hide"/>
                  <field name="legal_entity" string="Form" optional="hide"/>
                  <field name="vat_number" optional="hide"/>
                </list>
              </field>
              <p class="text-muted small mt-2 mb-0">
                Phone, director, address and other contact details are
                redacted in the preview and revealed only when you create
                leads (one billable reveal per selected company).
              </p>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Plain act_window entry point. Opens a fresh transient search record on a
       full-page form. (Access is gated by the menu's group + the model ACL.) -->
  <record id="action_bizfinder_search" model="ir.actions.act_window">
    <field name="name">Bizfinder</field>
    <field name="path">bizfinder</field>
    <field name="res_model">bizfinder.search</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
  </record>
</odoo>
