<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_bizfinder_company_event_list_jev" model="ir.ui.view">
    <field name="name">bizfinder.company.event.list.jev</field>
    <field name="model">bizfinder.company.event</field>
    <field name="inherit_id" ref="bizfinder.view_bizfinder_company_event_list"/>
    <field name="arch" type="xml">
      <field name="new_value" position="after">
        <field name="jev_kind" widget="badge"
               decoration-success="jev_kind == 'opportunity'"
               decoration-info="jev_kind == 'follow_up'"
               decoration-muted="jev_kind == 'informational'"/>
        <field name="jev_urgency" widget="percentage" optional="show" invisible="not jev_kind"/>
        <field name="jev_confidence" widget="percentage" optional="hide" invisible="not jev_kind"/>
      </field>
    </field>
  </record>

  <record id="view_bizfinder_company_event_form_jev" model="ir.ui.view">
    <field name="name">bizfinder.company.event.form.jev</field>
    <field name="model">bizfinder.company.event</field>
    <field name="inherit_id" ref="bizfinder.view_bizfinder_company_event_form"/>
    <field name="arch" type="xml">
      <sheet position="before">
        <header>
          <button name="action_jev_triage" type="object" string="Triage with AI"
                  class="btn-primary" groups="sales_team.group_sale_salesman"/>
        </header>
      </sheet>
      <xpath expr="//sheet/group[last()]" position="after">
        <group string="AI Triage" invisible="not jev_kind">
          <field name="jev_kind"/>
          <field name="jev_confidence" widget="percentage"/>
          <field name="jev_urgency" widget="percentage"/>
        </group>
      </xpath>
    </field>
  </record>

  <record id="view_bizfinder_company_event_search_jev" model="ir.ui.view">
    <field name="name">bizfinder.company.event.search.jev</field>
    <field name="model">bizfinder.company.event</field>
    <field name="inherit_id" ref="bizfinder.view_bizfinder_company_event_search"/>
    <field name="arch" type="xml">
      <field name="event_type" position="after">
        <separator/>
        <filter name="jev_opportunity" string="Sales opportunities" domain="[('jev_kind', '=', 'opportunity')]"/>
        <filter name="jev_follow_up" string="Account follow-ups" domain="[('jev_kind', '=', 'follow_up')]"/>
        <filter name="jev_untriaged" string="Not triaged" domain="[('jev_kind', '=', False)]"/>
      </field>
      <filter name="group_event_type" position="after">
        <filter name="group_jev_kind" string="AI triage" context="{'group_by': 'jev_kind'}"/>
      </filter>
    </field>
  </record>
</odoo>
